{
  "name": "pinkas-hamaman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/stamp-sw.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-imports.mjs && node scripts/check-jsx-identifiers.mjs && node scripts/test-iba-import.mjs",
    "images": "node scripts/fetch-images.mjs",
    "verify": "npm run check && npm run build",
    "app:sync": "npm run verify && npx cap sync android",
    "app:open": "npx cap open android",
    "app:build": "npm run app:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "vite": "^6.4.3"
  }
}
