<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 12.9.2026 — allowBackup="false": ה-WebView מחזיק במכשיר את סשן Supabase
         ואת העותק האופליין (שמות שחקנים, נוכחות, הרכבים), ו-@capacitor/preferences
         כותב ל-SharedPreferences. עם גיבוי אוטומטי כל זה עולה ל-Google Drive של
         בעל המכשיר — לרוב ילד — וניתן גם למשיכה ב-adb backup. מדיניות הפרטיות
         מצהירה שהעותק המקומי «יושב במכשיר שלך ואינו נשלח אלינו»; כיבוי הגיבוי הוא
         מה שהופך את המשפט לנכון גם מול גוגל. ⚠ Capacitor דורס את הקובץ רק ב-cap add,
         לא ב-cap sync — השינוי שורד. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
